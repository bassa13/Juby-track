# Client Environment Variables
# For local testing across separate devices (e.g. this app on a laptop + the
# TV scoreboard opened on an actual TV/tablet) BEFORE Supabase is configured,
# set this to the LAN IP of the machine running `server/`, e.g.
# http://192.168.1.20:5005 — "localhost" only ever means "this same device".
VITE_API_BASE_URL=http://localhost:5005

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# SMS API Gateway Configuration (Optional)
VITE_SMS_API_KEY=
VITE_SMS_API_BASE_URL=6zyv1d.api.infobip.com
VITE_SMS_API_SENDER=JubyClub
